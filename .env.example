# ==============================================================================
# DERBY CASINO ARENA - ENTERPRISE BACKEND CONFIGURATION
# ==============================================================================

# REST API Base URL (Point to your live Node.js / Python / Go / PHP backend)
VITE_API_BASE_URL=https://api.derbyarena.game/v1

# Real-time WebSocket Server URL (For synchronized multiplayer & live timers)
VITE_WS_URL=wss://api.derbyarena.game/ws

# Mock API Switch:
# Set to 'true' for standalone/offline demo testing (Zero backend dependencies)
# Set to 'false' to connect directly to production REST API endpoints
VITE_USE_MOCK_API=true

# Casino Operator & Game Identification
VITE_OPERATOR_ID=operator_tez_rafter
VITE_CURRENCY=COINS

